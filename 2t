class Handler(http.server.BaseHTTPRequestHandler):
def do_GET(self):
STATS.inc()
path = self.path.split("?")[0]

if path in ("/", "/index.html"):
self._html(page_accueil())
elif path == "/api/status":
self._json(STATS.get())
elif path == "/api/sites":
self._json({"sites": lister_sites()})
elif path == "/api/langages":
self._json({"langages": LANGAGES})
elif path == "/api/sse":
self._sse()
elif path.startswith("/site/"):
self._servir_site(path)
elif path.startswith("/static/"):
self._servir_static(path)
else:
self._404()

def do_HEAD(self):
STATS.inc()
self.send_response(200)
self.end_headers()

