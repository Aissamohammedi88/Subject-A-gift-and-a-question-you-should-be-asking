class Stats:
def __init__(self):
self.lock = threading.Lock()
self.requetes = 0
self.debut = time.time()
self.clients_sse = []

def inc(self):
with self.lock:
self.requetes += 1

def get(self):
with self.lock:
return {
"requetes": self.requetes,
"uptime": int(time.time() - self.debut),
"timestamp": datetime.now().isoformat(),
}

