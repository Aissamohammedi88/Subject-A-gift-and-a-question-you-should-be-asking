def port_libre(port):
try:
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(1)
r = s.connect_ex(("127.0.0.1", port))
s.close()
return r != 0
except Exception:
return False


def ip_locale():
try:
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.connect(("8.8.8.8", 80))
ip = s.getsockname()[0]
s.close()
return ip
except Exception:
return "127.0.0.1"


def lister_sites():
sites = []
if SITES_DIR.exists():
for d in SITES_DIR.iterdir():
if d.is_dir():
public = d / "public"
if public.exists():
sites.append({
"nom": d.name,
"chemin": str(public),
"mtime": d.stat().st_mtime,
"nb_fichiers": len(list(public.rglob("*"))),
})
return sorted(sites, key=lambda x: -x["mtime"])


def age_humain(ts):
age = time.time() - ts
if age < 60:
return f"il y a {int(age)}s"
elif age < 3600:
return f"il y a {int(age/60)}min"
elif age < 86400:
return f"il y a {int(age/3600)}h"
else:
return datetime.fromtimestamp(ts).strftime("%d/%m %H:%M")


